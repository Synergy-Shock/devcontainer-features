{
  "id": "pnpm",
  "version": "1.0.0",
  "name": "pnpm",
  "description": "Installs pnpm globally and configures the pnpm store directory and npm global prefix.",
  "documentationURL": "https://github.com/Synergy-Shock/devcontainer/tree/main/features/pnpm",
  "options": {
    "version": {
      "type": "string",
      "default": "10",
      "description": "Select or enter the version of pnpm to install globally.",
      "proposals": ["latest", "10", "9", "8"]
    }
  },
  "containerEnv": {
    "NPM_CONFIG_PREFIX": "/usr/local/share/npm-global",
    "PNPM_HOME": "/usr/local/share/pnpm",
    "PNPM_STORE_DIR": "/usr/local/share/pnpm-store",
    "PATH": "/usr/local/share/npm-global/bin:/usr/local/share/pnpm:/usr/local/bin:${PATH}"
  }
}
